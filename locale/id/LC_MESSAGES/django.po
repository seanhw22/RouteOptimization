msgid "RouteForge — Multi-Depot Vehicle Routing Optimizer"
msgstr "RouteForge — Pengoptimal Rute Kendaraan Multi-Depot"

msgid "My Datasets"
msgstr "Dataset Saya"

msgid "or"
msgstr "atau"

msgid "to save"
msgstr "untuk menyimpan"

