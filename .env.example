# MDVRP Configuration Example
# ============================
# Copy this file to .env and fill in your actual values

# Django secret key — generate one with: python -c "from django.core.utils.crypto import get_random_string; print(get_random_string(50))"
DJANGO_SECRET_KEY=your-secret-key-here

# Set to false in production
DJANGO_DEBUG=false

# Comma-separated list of allowed hosts (used when DJANGO_DEBUG=false)
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Cloudflare Tunnel URL (no trailing slash) — required for CSRF when using cloudflared
# CLOUDFLARE_URL=https://xxxx.trycloudflare.com

# PostgreSQL Database Connection
# Format: postgresql://user:password@host:port/database
DATABASE_URL=postgresql://postgres:yourpassword@localhost:5432/mdvrp

# Use database for MDVRP runs (true/false)
# - true: Try database first, fallback to CSV files if database fails
# - false: Use CSV files directly (skip database)
USE_DATABASE=true

# Dataset ID to load from database
# Only used when USE_DATABASE=true
# DATASET_ID=1

# Configuration Guide:
# ===================
#
# Update with your actual credentials:
# - user: Your PostgreSQL username
# - password: Your PostgreSQL password
# - host: localhost (or remote server)
# - port: 5432 (default PostgreSQL port)
# - database: mdvrp (or your database name)
#
# Data Source Priority (when USE_DATABASE=true):
# 1. Try database connection first
# 2. If database fails, fallback to CSV files in data/ directory
# 3. Error if both are unavailable
#
# Example for production:
# DATABASE_URL=postgresql://mdvrp_user:secure_password@db.example.com:5432/mdvrp_prod
# USE_DATABASE=true
# DATASET_ID=1
